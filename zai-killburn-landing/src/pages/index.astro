---
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { videos, products } from '../data/library';
import site from '../content/site.json';

const sortedProducts = [...products].sort((a, b) => a.price - b.price);
const hero = site.hero;
---

<Layout>
  <!-- HERO -->
  <section class="pt-24 pb-10 px-6" data-accent="red">
    <div class="max-w-[1600px] mx-auto">
      <!-- Metadata strip -->
      <div class="flex items-center justify-between mb-5 text-[11px] font-mono uppercase tracking-widest text-[var(--fg-dim)]">
        <div class="flex items-center gap-5">
          <span class="flex items-center gap-2 text-white">
            <span class="live-dot"></span>
            {hero.live}
          </span>
          <span class="hidden md:inline">{hero.date}</span>
          <span class="hidden md:inline">{hero.time}</span>
        </div>
        <div class="hidden md:flex items-center gap-5">
          <span>
            SUBS · <span class="text-white">{hero.subs}</span>
          </span>
          <span>
            VIDS · <span class="text-white">{hero.vids}</span>
          </span>
          <span style="color: var(--section-accent)">{hero.today}</span>
        </div>
      </div>

      <!-- Hero cinematic frame -->
      <div class="cinematic-frame vignette relative aspect-video cursor-pointer group">
        <img src={hero.image} alt={hero.imageAlt} class="w-full h-full object-cover absolute inset-0" />
        <div class="scan-overlay"></div>

        <!-- Gradient overlays -->
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent z-[2]"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-transparent to-black/20 z-[2]"></div>

        <!-- Top bar -->
        <div class="absolute top-0 left-0 right-0 p-5 md:p-7 flex items-start justify-between z-[5]">
          <div class="flex items-center gap-2.5 flex-wrap">
            <span class="bg-[var(--accent)] text-black text-[10px] font-bold px-2 py-1 uppercase tracking-wider font-mono">
              {hero.badges[0]}
            </span>
            <span class="text-[10px] font-mono text-white/90 border border-white/30 px-2 py-1 backdrop-blur bg-black/30">
              {hero.badges[1]}
            </span>
            <span class="hidden md:inline text-[10px] font-mono text-white/70 border border-white/20 px-2 py-1 backdrop-blur bg-black/30">
              {hero.badges[2]}
            </span>
          </div>
          <div class="hidden md:flex items-center gap-4 text-[10px] font-mono text-white/70">
            <span>
              <i class="fas fa-eye mr-1"></i> {hero.views}
            </span>
            <span>
              <i class="far fa-clock mr-1"></i> {hero.runtime}
            </span>
          </div>
        </div>

        <!-- Bottom content -->
        <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10 lg:p-14 z-[5]">
          <div class="max-w-4xl">
            <div class="text-[11px] font-mono uppercase tracking-widest text-[var(--accent)] mb-4 flex items-center gap-2">
              <span class="w-8 h-px bg-[var(--accent)]"></span>
              {hero.kicker}
            </div>
            <h1
              class="font-display text-4xl md:text-6xl lg:text-7xl text-white mb-5 accent-glow"
              style="text-wrap: balance"
            >
              {hero.titleA}
              <br />
              {hero.titleB}
            </h1>
            <p class="text-white/75 text-base md:text-lg lg:text-xl max-w-2xl mb-7 leading-relaxed font-light">
              {hero.lede}
            </p>
            <div class="flex flex-wrap items-center gap-3">
              <a href={hero.watchHref} class="btn-primary">
                <i class="fas fa-play text-[10px]"></i>
                {hero.watchLabel}
              </a>
              <a href={hero.readHref} class="btn-outline">
                <i class="fas fa-align-left text-[10px]"></i>
                {hero.readLabel}
              </a>
              <span class="hidden md:flex items-center gap-2 ml-2 text-[10px] font-mono uppercase tracking-widest text-white/40">
                <i class="fas fa-arrow-pointer"></i>Hover to preview
              </span>
            </div>
          </div>
        </div>

        <!-- Hover preview indicator -->
        <div class="absolute top-1/2 right-5 md:right-7 -translate-y-1/2 z-[5] opacity-0 group-hover:opacity-100 transition-opacity duration-300">
          <div class="bg-[var(--accent)] text-black text-[10px] font-mono font-bold px-3 py-2 flex items-center gap-2">
            <i class="fas fa-circle text-[6px] animate-pulse"></i>PREVIEWING
          </div>
        </div>

        <!-- Corner markers -->
        <div class="absolute top-3 left-3 w-3 h-3 border-t border-l border-white/40 z-[5]"></div>
        <div class="absolute top-3 right-3 w-3 h-3 border-t border-r border-white/40 z-[5]"></div>
        <div class="absolute bottom-3 left-3 w-3 h-3 border-b border-l border-white/40 z-[5]"></div>
        <div class="absolute bottom-3 right-3 w-3 h-3 border-b border-r border-white/40 z-[5]"></div>
      </div>

      <!-- Stats strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 mt-px border-y border-[var(--border)] bg-black">
        {site.stats.map((s) => (
          <div class="stat-cell">
            <div class="text-[10px] font-mono uppercase text-[var(--fg-dim)] mb-1.5 tracking-widest">
              {s.label}
            </div>
            <div
              class="font-display text-2xl md:text-3xl"
              style={s.accent ? 'color: var(--section-accent)' : undefined}
            >
              {s.value}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Marquee -->
  <div class="marquee-wrap">
    <div class="marquee-track font-display text-xl md:text-2xl">
      {[...site.marquee, ...site.marquee].map((item) => (
        <>
          <span class="px-6">{item}</span>
          <span class="px-3 text-[var(--accent)]">●</span>
        </>
      ))}
    </div>
  </div>

  <!-- VIDEO LIBRARY -->
  <section id="library" class="px-6 py-16 md:py-24" data-accent="blue">
    <div class="max-w-[1600px] mx-auto">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-6">
        <div>
          <div class="section-label mb-4">/ 01 — The Library</div>
          <h2 class="font-display text-5xl md:text-6xl lg:text-7xl" style="text-wrap: balance">
            Every video.
            <br />
            <span style="color: var(--section-accent)">No filter.</span>
          </h2>
          <p class="text-[var(--fg-dim)] mt-4 max-w-xl text-base">
            412 videos since 2019. Chronological, searchable, occasionally embarrassing. Hover any thumbnail
            for a silent preview.
          </p>
        </div>
        <div class="flex items-center gap-1 text-xs flex-wrap">
          <span class="text-[var(--fg-dim)] font-mono mr-2">SORT:</span>
          <button class="font-mono px-3 py-1.5 bg-white text-black font-bold">NEWEST</button>
          <button class="font-mono px-3 py-1.5 text-[var(--fg-dim)] hover:text-white transition border border-transparent hover:border-[var(--border)]">
            POPULAR
          </button>
          <button class="font-mono px-3 py-1.5 text-[var(--fg-dim)] hover:text-white transition border border-transparent hover:border-[var(--border)]">
            LONGEST
          </button>
        </div>
      </div>

      <!-- Filter chips -->
      <div class="flex gap-2 overflow-x-auto pb-3 mb-10 -mx-6 px-6 no-scrollbar">
        <button
          class="filter-chip active"
          data-filter="all"
          hx-get="/api/videos/all"
          hx-target="#videoGrid"
          hx-swap="innerHTML"
          hx-indicator="#videoGrid"
        >
          All <span class="count">412</span>
        </button>
        <button
          class="filter-chip"
          data-filter="review"
          hx-get="/api/videos/review"
          hx-target="#videoGrid"
          hx-swap="innerHTML"
          hx-indicator="#videoGrid"
        >
          Reviews <span class="count">187</span>
        </button>
        <button
          class="filter-chip"
          data-filter="comparison"
          hx-get="/api/videos/comparison"
          hx-target="#videoGrid"
          hx-swap="innerHTML"
          hx-indicator="#videoGrid"
        >
          Comparisons <span class="count">94</span>
        </button>
        <button
          class="filter-chip"
          data-filter="news"
          hx-get="/api/videos/news"
          hx-target="#videoGrid"
          hx-swap="innerHTML"
          hx-indicator="#videoGrid"
        >
          News &amp; Takes <span class="count">68</span>
        </button>
        <button
          class="filter-chip"
          data-filter="deep"
          hx-get="/api/videos/deep"
          hx-target="#videoGrid"
          hx-swap="innerHTML"
          hx-indicator="#videoGrid"
        >
          Deep Dives <span class="count">34</span>
        </button>
        <button
          class="filter-chip"
          data-filter="setup"
          hx-get="/api/videos/setup"
          hx-target="#videoGrid"
          hx-swap="innerHTML"
          hx-indicator="#videoGrid"
        >
          Setups <span class="count">19</span>
        </button>
        <button
          class="filter-chip"
          data-filter="bts"
          hx-get="/api/videos/bts"
          hx-target="#videoGrid"
          hx-swap="innerHTML"
          hx-indicator="#videoGrid"
        >
          Behind The Scenes <span class="count">10</span>
        </button>
      </div>

      <!-- Video grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-5 gap-y-10" id="videoGrid">
        {videos.map((v, i) => (
          <VideoCard video={v} index={i} />
        ))}
      </div>

      <div class="mt-14 flex flex-col items-center gap-4">
        <button
          class="btn-outline"
          hx-get="/api/videos/more"
          hx-target="#videoGrid"
          hx-swap="beforeend"
          hx-indicator="#videoGrid"
        >
          Load 12 More <i class="fas fa-arrow-down text-[10px]"></i>
        </button>
        <p class="text-xs text-[var(--fg-dim)] font-mono">SHOWING 12 OF 412</p>
      </div>
    </div>
  </section>

  <!-- WRITTEN REVIEW (Sticky Video Companion) -->
  <section id="reviews" class="px-6 py-16 md:py-24 border-t border-[var(--border)]" data-accent="red">
    <div class="max-w-[1600px] mx-auto">
      <div class="mb-12 max-w-3xl">
        <div class="section-label mb-4">/ 02 — Written Companion</div>
        <h2 class="font-display text-5xl md:text-6xl lg:text-7xl mb-5" style="text-wrap: balance">
          Read along,
          <br />
          <span style="color: var(--section-accent)">while it plays.</span>
        </h2>
        <p class="text-[var(--fg-dim)] text-base md:text-lg">
          The video stays pinned on the left. The article scrolls on the right. Charts, benchmarks, and
          opinions — without losing the footage.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16">
        <!-- Left: sticky video player -->
        <div class="lg:sticky lg:top-24 lg:self-start">
          <div class="video-player-shell">
            <div class="video-player-screen">
              <img src="/img/reviewvid-1280x720.jpg" alt="Video still" />
              <div class="absolute top-4 left-4 bg-black/80 backdrop-blur px-3 py-2 text-[10px] font-mono uppercase tracking-widest flex items-center gap-2 z-10">
                <span class="live-dot"></span>Reading Mode · Video Pinned
              </div>
              <div class="absolute top-4 right-4 bg-black/80 backdrop-blur px-3 py-2 text-[10px] font-mono text-white z-10">
                06:43 / 18:24
              </div>
              <div class="absolute inset-0 flex items-center justify-center bg-black/30">
                <button class="w-16 h-16 bg-white/95 text-black flex items-center justify-center hover:bg-[var(--accent)] hover:text-white transition">
                  <i class="fas fa-pause text-xl"></i>
                </button>
              </div>
              <div class="absolute bottom-0 left-0 right-0 h-20 bg-gradient-to-t from-black to-transparent pointer-events-none"></div>
            </div>
            <div class="video-controls">
              <div class="video-progress">
                <div class="video-progress-fill"></div>
              </div>
              <div class="flex items-center justify-between text-white">
                <div class="flex items-center gap-3">
                  <button class="text-white hover:text-[var(--accent)] transition">
                    <i class="fas fa-backward-step text-xs"></i>
                  </button>
                  <button class="text-white hover:text-[var(--accent)] transition">
                    <i class="fas fa-play text-sm"></i>
                  </button>
                  <button class="text-white hover:text-[var(--accent)] transition">
                    <i class="fas fa-forward-step text-xs"></i>
                  </button>
                  <span class="font-mono text-[11px] text-white/70 ml-2">06:43 / 18:24</span>
                </div>
                <div class="flex items-center gap-3 text-white/80">
                  <button class="hover:text-white transition">
                    <i class="fas fa-volume-high text-xs"></i>
                  </button>
                  <button class="hover:text-white transition">
                    <i class="fas fa-closed-captioning text-xs"></i>
                  </button>
                  <button class="hover:text-white transition">
                    <i class="fas fa-cog text-xs"></i>
                  </button>
                  <button class="hover:text-white transition">
                    <i class="fas fa-expand text-xs"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>

          <!-- Video meta -->
          <div class="mt-6 pb-6 border-b border-[var(--border)]">
            <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--accent)] mb-2">
              Ep. 247 · Flagship Review
            </div>
            <h3 class="font-display text-2xl md:text-3xl mb-3 leading-tight">
              The Phone That Killed The Compact Flagship.
            </h3>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[var(--fg-dim)] font-mono">
              <span>18:24</span>
              <span>·</span>
              <span>MAR 14, 2025</span>
              <span>·</span>
              <span>142,304 views</span>
              <span>·</span>
              <span class="text-[var(--accent)]">↑ 8.4K likes</span>
            </div>
          </div>

          <!-- Chapters -->
          <div class="mt-6">
            <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)] mb-3">
              Chapters
            </div>
            <div class="space-y-1">
              <button class="chapter active">
                <span>00:00 — Intro: the small phone problem</span>
                <i class="fas fa-play text-[10px] text-[var(--accent)]"></i>
              </button>
              <button class="chapter text-[var(--fg-dim)]">
                <span>02:14 — Build &amp; in-hand feel</span>
                <span class="text-[10px] text-[var(--fg-mute)] font-mono">02:14</span>
              </button>
              <button class="chapter text-[var(--fg-dim)]">
                <span>05:48 — The display reality check</span>
                <span class="text-[10px] text-[var(--fg-mute)] font-mono">05:48</span>
              </button>
              <button class="chapter text-[var(--fg-dim)]">
                <span>08:32 — Battery: three-week data</span>
                <span class="text-[10px] text-[var(--fg-mute)] font-mono">08:32</span>
              </button>
              <button class="chapter text-[var(--fg-dim)]">
                <span>12:19 — Cameras in low light</span>
                <span class="text-[10px] text-[var(--fg-mute)] font-mono">12:19</span>
              </button>
              <button class="chapter text-[var(--fg-dim)]">
                <span>15:41 — Verdict &amp; alternatives</span>
                <span class="text-[10px] text-[var(--fg-mute)] font-mono">15:41</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Right: article -->
        <article class="article-body max-w-2xl">
          <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--accent)] mb-4">
            Deep-Dive Companion · 4,200 words · 12 min read
          </div>
          <h2 class="font-display text-3xl md:text-5xl mb-7 leading-[1.02]" style="text-wrap: balance">
            Three weeks. Eleven instruments. One conclusion about small phones.
          </h2>

          <div class="flex items-center gap-4 mb-10 pb-6 border-b border-[var(--border)]">
            <img src="/img/marcusportrait-120x120.jpg" class="w-12 h-12 object-cover" alt="Author" />
            <div class="flex-1">
              <div class="font-semibold text-sm">Marcus Kilburn</div>
              <div class="text-[10px] text-[var(--fg-dim)] font-mono uppercase tracking-widest mt-0.5">
                Senior Editor · 6 Years On The Beat
              </div>
            </div>
            <div class="flex gap-2">
              <button class="w-9 h-9 border border-[var(--border)] flex items-center justify-center hover:border-white transition text-xs">
                <i class="fab fa-x-twitter"></i>
              </button>
              <button class="w-9 h-9 border border-[var(--border)] flex items-center justify-center hover:border-white transition text-xs">
                <i class="fab fa-instagram"></i>
              </button>
            </div>
          </div>

          <p class="drop-cap">
            There's a particular kind of disappointment that comes from a phone that's almost right. The
            Aspect Mini Pro is the most frustrating device I've tested this year — not because it's bad, but
            because it's <em>so close</em> to being the answer to a question we've been asking for half a
            decade: can a small phone still be a flagship?
          </p>

          <p>
            For context: I've been daily-driving compact Androids since the original Pixel 5. Every year, the
            category gets a eulogy. Every year, some manufacturer tries to revive it. The Mini Pro is Aspect's
            third attempt, and the first one I'd actually recommend to someone who isn't a masochist with
            small hands.
          </p>

          <p>
            But "recommend" comes with footnotes, and the footnotes matter. Let's walk through what works,
            what doesn't, and why a phone I genuinely enjoy using still made me angry enough to write 4,200
            words about it.
          </p>

          <div class="pull-quote">
            "It's not that the phone is perfect — it's that the compromises are finally in the right places.
            Mostly."
          </div>

          <h3>Build Quality &amp; In-Hand Feel</h3>

          <p>
            The Mini Pro is the first compact phone since the iPhone 13 Mini that doesn't feel like a
            concession. At 168g, it's substantial without being heavy. The titanium frame is cold to the touch
            in a way that signals <strong>"this is a real piece of hardware"</strong>, not a budget
            compromise.
          </p>

          <p>
            I spent two weeks using it alongside my daily Pixel 9 Pro, and every time I picked up the Mini Pro
            there was a small dopamine hit that comes from a device that fits. My thumb reaches the top
            corner. The power button sits where my thumb naturally falls. The phone disappears into a jeans
            pocket.
          </p>

          <p>
            These sound like small things. They are not. After a decade of phones designed for hands the size
            of dinner plates, the Mini Pro feels like coming home.
          </p>

          <h3>The Display: A Reality Check</h3>

          <p>
            Here's where the praise gets complicated. The 6.1-inch LTPO panel is, on paper, excellent: 1-120Hz
            adaptive, 2400 nits peak, Dolby Vision. In practice, it's <em>very good</em>, with one specific
            weakness I haven't seen mentioned in other reviews.
          </p>

          <p>
            Outdoor visibility in direct sunlight is roughly 15% worse than the iPhone 15 Pro's display when
            measured with my Sekonic C-800. That's not catastrophic, but it's the kind of number that
            separates "great" from "best in class." Aspect's marketing leans heavily on the 2400-nit peak, but
            peak brightness is a misleading metric — sustained outdoor brightness matters more, and that's
            where the Mini Pro falls short.
          </p>

          <p>
            For most people, indoors or in shade, this won't matter. If you live somewhere sunny and work
            outside, it might.
          </p>

          <div class="my-8 p-5 border-l-2 border-[var(--accent)] bg-white/[0.02]">
            <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--accent)] mb-2">
              Measurement Note
            </div>
            <p class="text-sm m-0 text-[var(--fg-dim)]">
              All display measurements taken with a Sekonic C-800 color meter, calibrated January 2025. Three
              readings averaged per data point. Full methodology available on request.
            </p>
          </div>

          <h3>The Battery Question</h3>

          <p>
            Let's address the elephant. The 4,200 mAh cell is, on paper, a regression from last year's 4,800.
            In practice, the new 3nm silicon more than compensates — but only if you don't game.
          </p>

          <p>
            Over 21 days of testing, I averaged <strong>6 hours 42 minutes</strong> of screen-on time per day.
            That's with mixed use: 90 minutes of YouTube, 45 minutes of navigation, 2 hours of social, the
            rest split between messaging, photography, and browsing. Standby drain averaged 1.8% per hour —
            excellent, though not class-leading.
          </p>

          <p>
            The moment you fire up Genshin Impact, the picture changes. Sustained 30-minute sessions dropped
            battery by 22%, and the phone got noticeably warm. Aspect's thermal management is good, but the
            laws of physics are unforgiving in a chassis this small.
          </p>

          <p>
            Should you care? If you're a serious mobile gamer, the Mini Pro isn't for you — and Aspect isn't
            pretending otherwise. For everyone else, the battery is genuinely a non-issue.
          </p>

          <h3>Cameras: Three Lenses, Two Good Surprises</h3>

          <p>
            The camera system is where the Mini Pro most exceeds expectations. The 50MP main sensor is a known
            quantity — it's the same unit as the full-size Aspect 12, and performs identically. The 12MP
            ultrawide is fine, nothing special.
          </p>

          <p>
            The telephoto, though, is a revelation. Aspect put a 3x optical periscope in a phone that's 8.4mm
            thick. I'm not sure how, and I'm not sure it should be possible. But it works, and the resulting
            photos in the 3-6x range are sharper than what I get from my Pixel 9 Pro's 5x in good light.
          </p>

          <p>
            Low light remains the Mini Pro's weak spot. The smaller sensor physics still apply, and while
            Aspect's computational pipeline does impressive work, the Pixel 9 Pro and iPhone 16 Pro both
            produce cleaner images at night. That's a tradeoff I'd happily make.
          </p>

          <div class="pull-quote">
            "The fact that I keep reaching for the Mini Pro instead of my Pixel says something. I'm just not
            entirely sure what."
          </div>

          <h3>The Verdict</h3>

          <p>
            The Aspect Mini Pro isn't perfect. The display could be brighter. The battery takes a hit under
            load. Low-light photography lags the competition. It costs $899, which is exactly the price of a
            Pixel 9 Pro with a bigger screen and better camera.
          </p>

          <p>
            And yet, three weeks in, I keep using it. Because the Mini Pro does something its competitors
            don't: it disappears. It's a phone that doesn't demand attention, doesn't bulge in my pocket,
            doesn't require two hands to use safely. It's a tool, in the best sense of the word.
          </p>

          <p>
            If you've been waiting for a small phone that doesn't suck, this is it. If you don't care about
            size, get a Pixel. Both are reasonable decisions.
          </p>

          <p class="text-[var(--fg-dim)] text-sm italic mt-12 pt-6 border-t border-[var(--border)]">
            The Aspect Mini Pro was purchased retail for this review. No review unit, no loaner, no sponsor.
            Full disclosure in the description.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- RECOMMENDATIONS -->
  <section
    id="recommendations"
    class="px-6 py-16 md:py-24 border-t border-[var(--border)]"
    data-accent="yellow"
  >
    <div class="max-w-[1600px] mx-auto">
      <div class="mb-12 max-w-3xl">
        <div class="section-label mb-4">/ 03 — What I'd Buy</div>
        <h2 class="font-display text-5xl md:text-6xl lg:text-7xl mb-5" style="text-wrap: balance">
          Money where
          <br />
          <span style="color: var(--section-accent)">my mouth is.</span>
        </h2>
        <p class="text-[var(--fg-dim)] text-base md:text-lg">
          Drag the slider. Watch the list re-sort in real time. These are products I've actually bought with
          my own money — not sponsor deals, not loaners.
        </p>
      </div>

      <!-- Price slider control -->
      <div class="bg-black border border-[var(--border)] p-6 md:p-8 mb-10">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-6 gap-4">
          <div>
            <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)] mb-2">
              Budget Range
            </div>
            <div class="flex items-baseline gap-3 flex-wrap">
              <span
                class="font-display text-4xl md:text-5xl"
                style="color: var(--section-accent)"
                id="priceLowDisplay"
              >
                $50
              </span>
              <span class="text-[var(--fg-dim)] font-display text-3xl">—</span>
              <span
                class="font-display text-4xl md:text-5xl"
                style="color: var(--section-accent)"
                id="priceHighDisplay"
              >
                $2,000
              </span>
            </div>
          </div>
          <div class="text-right">
            <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)] mb-2">
              Matches
            </div>
            <div class="flex items-baseline gap-2 justify-end">
              <span class="font-display text-4xl md:text-5xl" id="productCount">
                12
              </span>
              <span class="text-xs text-[var(--fg-dim)] font-mono uppercase">PRODUCTS</span>
            </div>
          </div>
        </div>

        <div class="space-y-5">
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)]">
                Minimum
              </label>
              <span class="text-xs font-mono" id="priceLowLabel">
                $50
              </span>
            </div>
            <input type="range" min="0" max="2000" value="50" step="10" class="price-slider" id="priceLow" />
          </div>
          <div>
            <div class="flex items-center justify-between mb-2">
              <label class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)]">
                Maximum
              </label>
              <span class="text-xs font-mono" id="priceHighLabel">
                $2,000
              </span>
            </div>
            <input
              type="range"
              min="0"
              max="2000"
              value="2000"
              step="10"
              class="price-slider"
              id="priceHigh"
            />
          </div>
        </div>
      </div>

      <!-- Category filter row -->
      <div class="flex gap-2 flex-wrap mb-8 text-xs font-mono">
        <span class="text-[var(--fg-dim)] uppercase mr-2 self-center">Filter:</span>
        <a href="/picks" class="px-3 py-1 bg-[var(--yellow)] text-black font-bold">
          ALL
        </a>
        <a href="/picks" class="px-3 py-1 border border-[var(--border)] hover:border-white transition">
          AUDIO
        </a>
        <a href="/picks" class="px-3 py-1 border border-[var(--border)] hover:border-white transition">
          DISPLAYS
        </a>
        <a href="/picks" class="px-3 py-1 border border-[var(--border)] hover:border-white transition">
          INPUT
        </a>
        <a href="/picks" class="px-3 py-1 border border-[var(--border)] hover:border-white transition">
          PHONES
        </a>
        <a href="/picks" class="px-3 py-1 border border-[var(--border)] hover:border-white transition">
          CAMERA
        </a>
      </div>

      <!-- Recommendation grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4" id="recGrid">
        {sortedProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section
    id="newsletter"
    class="px-6 py-24 md:py-32 border-t border-[var(--border)] relative overflow-hidden"
    data-accent="red"
  >
    <div class="absolute inset-0 opacity-40 pointer-events-none">
      <div
        class="absolute -top-1/2 -right-1/4 w-[800px] h-[800px] rounded-full blur-3xl"
        style="background: radial-gradient(circle, rgba(255,42,42,0.25), transparent 70%)"
      ></div>
      <div
        class="absolute -bottom-1/3 -left-1/4 w-[600px] h-[600px] rounded-full blur-3xl"
        style="background: radial-gradient(circle, rgba(43,111,255,0.12), transparent 70%)"
      ></div>
    </div>

    <div class="max-w-4xl mx-auto text-center relative z-10">
      <div class="section-label mb-6 justify-center" style="display: inline-flex">
        / 04 — Direct Line
      </div>

      <h2 class="font-display text-5xl md:text-6xl lg:text-8xl mb-6" style="text-wrap: balance">
        Get the takes
        <br />
        <span style="color: var(--section-accent)">before they're public.</span>
      </h2>

      <p class="text-[var(--fg-dim)] text-base md:text-lg mb-12 max-w-xl mx-auto">
        One email. Every Sunday. Three products, two opinions, zero filler. 47,831 readers and counting.
      </p>

      <form
        class="text-left max-w-2xl mx-auto"
        id="newsletterForm"
        novalidate
        hx-post="/api/subscribe"
        hx-target="#subscribeStatus"
        hx-swap="innerHTML"
      >
        <div class="flex items-end gap-4 mb-4">
          <div class="flex-1">
            <label class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)] mb-2 block">
              Your Email Address
            </label>
            <input
              type="email"
              id="emailInput"
              name="email"
              class="newsletter-input"
              placeholder=""
              autocomplete="email"
            />
          </div>
          <button type="submit" class="btn-primary mb-3 whitespace-nowrap">
            Subscribe <i class="fas fa-arrow-right text-[10px]"></i>
          </button>
        </div>
        <div class="text-xs text-[var(--fg-dim)] flex items-center gap-3 mb-2">
          <i class="fas fa-shield-halved"></i>
          <span>No spam. Unsubscribe in one click. I personally read every reply — even the angry ones.</span>
        </div>
        <div
          id="subscribeStatus"
          class="text-xs font-mono mt-3"
          style="color: var(--section-accent); min-height: 1em;"
        ></div>
      </form>

      <div class="mt-20 grid grid-cols-3 gap-6 max-w-2xl mx-auto">
        <div class="text-left">
          <div class="font-display text-4xl md:text-5xl" style="color: var(--section-accent)">
            47K
          </div>
          <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)] mt-2">
            Subscribers
          </div>
        </div>
        <div class="text-left">
          <div class="font-display text-4xl md:text-5xl">52</div>
          <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)] mt-2">
            Issues Sent
          </div>
        </div>
        <div class="text-left">
          <div class="font-display text-4xl md:text-5xl">4.3</div>
          <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)] mt-2">
            Min Avg Read
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PATREON / BTS -->
  <section class="px-6 py-16 md:py-24 border-t border-[var(--border)]" data-accent="blue">
    <div class="max-w-[1600px] mx-auto">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <div class="section-label mb-4">/ 05 — Behind The Curtain</div>
          <h2 class="font-display text-5xl md:text-6xl lg:text-7xl mb-6" style="text-wrap: balance">
            The cuts that
            <br />
            didn't make
            <br />
            <span style="color: var(--section-accent)">the video.</span>
          </h2>
          <p class="text-[var(--fg-dim)] text-base md:text-lg mb-6 max-w-lg">
            Members get raw footage, failed takes, the spreadsheets behind every comparison, and a private
            monthly Q&amp;A. Three tiers. Cancel anytime. No tiers locked behind "exclusive content" — it's
            all stuff that wouldn't exist without your support.
          </p>
          <div class="flex flex-wrap gap-3 mb-8">
            <a href="/membership" class="btn-primary">
              <i class="fab fa-patreon text-xs"></i>Join On Patreon
            </a>
            <a href="/membership#tiers" class="btn-outline">
              See Tiers
            </a>
          </div>
          <div class="text-xs text-[var(--fg-dim)] font-mono">
            <span class="text-[var(--accent)]">2,847</span> members · avg rating 4.9/5
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <div class="aspect-square overflow-hidden col-span-2 row-span-2">
            <img
              src="/img/studio1-600x600.jpg"
              class="w-full h-full object-cover grayscale hover:grayscale-0 transition duration-700"
            />
          </div>
          <div class="aspect-square overflow-hidden">
            <img
              src="/img/studio2-300x300.jpg"
              class="w-full h-full object-cover grayscale hover:grayscale-0 transition duration-700"
            />
          </div>
          <div class="aspect-square overflow-hidden">
            <img
              src="/img/studio3-300x300.jpg"
              class="w-full h-full object-cover grayscale hover:grayscale-0 transition duration-700"
            />
          </div>
          <div class="aspect-square overflow-hidden col-span-2">
            <img
              src="/img/studio4-600x300.jpg"
              class="w-full h-full object-cover grayscale hover:grayscale-0 transition duration-700"
            />
          </div>
          <div class="aspect-square overflow-hidden">
            <img
              src="/img/studio5-300x300.jpg"
              class="w-full h-full object-cover grayscale hover:grayscale-0 transition duration-700"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT / STUDIO -->
  <section id="about" class="px-6 py-16 md:py-24 border-t border-[var(--border)]">
    <div class="max-w-[1600px] mx-auto">
      <div class="grid lg:grid-cols-12 gap-10">
        <div class="lg:col-span-5">
          <div class="lg:sticky lg:top-24">
            <div class="aspect-[4/5] overflow-hidden bg-black relative">
              <img
                src="/img/marcusbw-800x1000.jpg"
                class="w-full h-full object-cover"
                alt="Marcus Kilburn portrait"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>
              <div class="absolute top-3 left-3 w-3 h-3 border-t border-l border-white/60"></div>
              <div class="absolute top-3 right-3 w-3 h-3 border-t border-r border-white/60"></div>
              <div class="absolute bottom-3 left-3 w-3 h-3 border-b border-l border-white/60"></div>
              <div class="absolute bottom-3 right-3 w-3 h-3 border-b border-r border-white/60"></div>
            </div>
            <div class="mt-4 grid grid-cols-3 gap-2 text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)]">
              <div>
                <div class="text-white mb-1">MARCUS KILBURN</div>
                <div>FOUNDER / HOST</div>
              </div>
              <div>
                <div class="text-white mb-1">EST. 2019</div>
                <div>LONDON / TOKYO</div>
              </div>
              <div>
                <div class="text-[var(--accent)] mb-1">6 YRS</div>
                <div>412 VIDEOS</div>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-span-7">
          <div class="section-label mb-4">/ 06 — About</div>
          <h2 class="font-display text-4xl md:text-6xl mb-8" style="text-wrap: balance">
            One person.
            <br />
            One opinion.
            <br />
            <span class="text-[var(--fg-dim)]">A lot of cables.</span>
          </h2>

          <div class="space-y-5 text-base md:text-lg text-[var(--fg-dim)] leading-relaxed max-w-2xl">
            <p>
              I started making videos in 2019 because I was tired of tech reviews that read like press
              releases. Six years and 412 videos later, that's still the only rule: if I wouldn't say it to a
              friend over coffee, it doesn't go in the script.
            </p>
            <p>
              Every product on this site was either bought retail, borrowed from a friend, or returned after
              testing. No review units. No sponsored first impressions. No "this changes everything"
              thumbnails for products that don't.
            </p>
            <p>
              The studio is in <span class="text-white">East London</span>. The editing happens in{' '}
              <span class="text-white">Tokyo</span>. The opinions are entirely my own and frequently wrong,
              which I think is fine.
            </p>
          </div>

          <div class="mt-12 space-y-3">
            <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)] mb-4">
              Operating Principles
            </div>
            <div class="flex items-start gap-4 py-3 border-b border-[var(--border)]">
              <span class="font-display text-2xl text-[var(--accent)] w-12 shrink-0">01</span>
              <div>
                <div class="font-semibold">If it's sponsored, it says so. Loudly.</div>
                <div class="text-sm text-[var(--fg-dim)] mt-1">
                  Three sponsors max per year. Always disclosed. Never the main video.
                </div>
              </div>
            </div>
            <div class="flex items-start gap-4 py-3 border-b border-[var(--border)]">
              <span class="font-display text-2xl text-[var(--accent)] w-12 shrink-0">02</span>
              <div>
                <div class="font-semibold">Three-week minimum testing window.</div>
                <div class="text-sm text-[var(--fg-dim)] mt-1">
                  No "first impressions" passed off as reviews. If I haven't lived with it, I won't grade it.
                </div>
              </div>
            </div>
            <div class="flex items-start gap-4 py-3 border-b border-[var(--border)]">
              <span class="font-display text-2xl text-[var(--accent)] w-12 shrink-0">03</span>
              <div>
                <div class="font-semibold">Numbers over adjectives.</div>
                <div class="text-sm text-[var(--fg-dim)] mt-1">
                  "Fast" is meaningless. "47ms latency measured at 1kHz" is something I can defend.
                </div>
              </div>
            </div>
            <div class="flex items-start gap-4 py-3">
              <span class="font-display text-2xl text-[var(--accent)] w-12 shrink-0">04</span>
              <div>
                <div class="font-semibold">Wrong is fine. Lying isn't.</div>
                <div class="text-sm text-[var(--fg-dim)] mt-1">
                  When I get something wrong, I update the video and pin the correction. Errors are public.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
