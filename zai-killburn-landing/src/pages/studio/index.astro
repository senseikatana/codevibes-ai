---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import author from '../../content/author.json';
---

<Layout title="Studio — KILBURN" description={`${author.tagline} East London / Tokyo.`}>
  <PageHero
    kicker="/ 06 — About"
    title="One person. One opinion."
    accentWord="A lot of cables."
    accent="red"
    lede="Videos since 2019 because tech reviews kept reading like press releases. Every product bought retail, borrowed, or returned."
  />
  <section class="px-6 pb-24">
    <div class="max-w-[1600px] mx-auto grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-5">
        <div class="aspect-[4/5] overflow-hidden bg-black relative">
          <img src={author.portrait} class="w-full h-full object-cover" alt={`${author.name} portrait`} />
        </div>
        <div class="mt-4 grid grid-cols-3 gap-2 text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)]">
          {author.facts.map((f) => (
            <div>
              <div class="text-white mb-1">{f.k}</div>
              <div>{f.v}</div>
            </div>
          ))}
        </div>
      </div>
      <div class="lg:col-span-7">
        <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)] mb-4">
          Operating Principles
        </div>
        <div class="space-y-0 max-w-2xl">
          {author.principles.map((p, i) => (
            <div class={i < author.principles.length - 1 ? 'py-4 border-b border-[var(--border)]' : 'py-4'}>
              <span class="font-display text-2xl text-[var(--accent)] mr-4">{p.n}</span>
              <strong>{p.title}</strong>
              <p class="text-sm text-[var(--fg-dim)] mt-1">{p.note}</p>
            </div>
          ))}
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/studio/equipment" class="btn-outline">
            Equipment
          </a>
          <a href="/studio/methodology" class="btn-outline">
            Methodology
          </a>
          <a href="/studio/ethics" class="btn-outline">
            Ethics policy
          </a>
          <a href="/contact" class="btn-primary">
            Contact <i class="fas fa-arrow-right text-[10px]"></i>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
