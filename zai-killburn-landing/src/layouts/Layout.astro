---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import site from '../content/site.json';
import { headTags, siteUrl } from '../data/seo';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'KILBURN — Tech Reviews Without the Marketing Filter',
  description = 'Tech reviews without the marketing filter. One human, one opinion, 412 videos and counting.',
  image,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <Fragment
      set:html={headTags(title, description, siteUrl(Astro.url.pathname), image ? siteUrl(image) : undefined)}
    />
    <ClientRouter />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23080808'/%3E%3Crect x='6' y='6' width='20' height='20' fill='%23ff2a2a'/%3E%3Ctext x='16' y='22' font-family='monospace' font-size='16' font-weight='bold' text-anchor='middle' fill='%23000'%3EK%3C/text%3E%3C/svg%3E"
    />
  </head>
  <body hx-boost="false">
    <div class="scroll-progress-bar" id="scrollProgress"></div>

    <button class="back-to-top" id="backToTop" aria-label="Back to top">
      <i class="fas fa-arrow-up"></i>
    </button>

    <header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-xl bg-black/60 border-b border-white/5">
      <div class="max-w-[1600px] mx-auto px-6 py-4 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3 group">
          <div
            class="w-9 h-9 flex items-center justify-center font-display text-black text-xl transition-colors"
            style="background: var(--section-accent)"
          >
            {site.brand.mark}
          </div>
          <div class="flex flex-col leading-none">
            <span class="font-display text-xl tracking-tight">{site.brand.name}</span>
            <span class="text-[10px] font-mono text-[var(--fg-dim)] tracking-widest">
              {site.brand.tagline}
            </span>
          </div>
        </a>

        <nav class="hidden lg:flex items-center gap-8 text-sm font-medium">
          {site.nav.map((item) => (
            <a
              href={item.href}
              class="hover:text-white text-[var(--fg-dim)] transition flex items-center gap-1.5"
            >
              <span class="font-mono text-xs text-[var(--fg-mute)]">{item.n}</span>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-3">
          <a
            href="/archive"
            class="hidden md:flex items-center gap-2 text-sm text-[var(--fg-dim)] hover:text-white transition px-3 py-2 border border-transparent hover:border-[var(--border)]"
            aria-label="Archive"
          >
            <i class="fas fa-search text-xs"></i>
            <span class="font-mono">/</span>
          </a>
          <a href="/newsletter" class="btn-primary text-xs">
            Subscribe <i class="fas fa-arrow-right text-[10px]"></i>
          </a>
          <button
            id="menuButton"
            class="lg:hidden w-10 h-10 border border-[var(--border)] flex items-center justify-center hover:border-white transition"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobileMenu"
          >
            <i class="fas fa-bars text-sm" id="menuIcon"></i>
          </button>
        </div>
      </div>
    </header>

    <nav id="mobileMenu" class="mobile-menu" aria-label="Mobile navigation" aria-hidden="true">
      <div class="mobile-menu-links">
        {site.mobileNav.map((item, i) => (
          <a href={item.href} style={`--i: ${i}`}>
            <span class="font-mono">{item.n}</span>
            {item.label}
          </a>
        ))}
      </div>
      <a href="/newsletter" class="btn-primary">
        Subscribe <i class="fas fa-arrow-right text-[10px]"></i>
      </a>
      <div class="mobile-menu-foot">EST. 2019 · LONDON / TOKYO</div>
    </nav>

    <slot />

    <footer class="px-6 pt-16 pb-8 border-t border-[var(--border)]">
      <div class="max-w-[1600px] mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-5 gap-8 mb-16">
          <div class="col-span-2">
            <div class="flex items-center gap-3 mb-6">
              <div
                class="w-9 h-9 flex items-center justify-center font-display text-black text-xl"
                style="background: var(--section-accent)"
              >
                {site.brand.mark}
              </div>
              <div>
                <div class="font-display text-xl">{site.brand.name}</div>
                <div class="text-[10px] font-mono text-[var(--fg-dim)] tracking-widest">{site.brand.est}</div>
              </div>
            </div>
            <p class="text-sm text-[var(--fg-dim)] max-w-sm mb-6">{site.footer.blurb}</p>
            <div class="flex gap-3">
              {site.footer.socials.map((s) => (
                <a
                  href={s.href}
                  class="w-10 h-10 border border-[var(--border)] flex items-center justify-center hover:border-white hover:bg-white hover:text-black transition"
                  aria-label={s.label}
                >
                  <i class={s.icon}></i>
                </a>
              ))}
            </div>
          </div>

          {site.footer.columns.map((col) => (
            <div>
              <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)] mb-4">
                {col.title}
              </div>
              <ul class="space-y-2 text-sm">
                {col.links.map((l) => (
                  <li>
                    <a href={l.href} class="hover:text-[var(--accent)] transition">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="pt-8 border-t border-[var(--border)] flex flex-col md:flex-row md:items-center justify-between gap-4 text-xs text-[var(--fg-dim)] font-mono">
          <div class="flex items-center gap-4">
            <span>{site.brand.company}</span>
            <span class="hidden md:inline">·</span>
            <span class="hidden md:inline">{site.brand.companyNo}</span>
          </div>
          <div class="flex items-center gap-4 flex-wrap">
            {site.footer.legal.map((l) => (
              <a href={l.href} class="hover:text-white transition uppercase">
                {l.label}
              </a>
            ))}
            <span class="flex items-center gap-2" style="color: var(--section-accent)">
              <span class="live-dot"></span>ALL SYSTEMS OPERATIONAL
            </span>
          </div>
        </div>
      </div>
    </footer>

    <script src="/js/htmx.min.js" defer></script>
    <script src="../scripts/main.js"></script>
  </body>
</html>
