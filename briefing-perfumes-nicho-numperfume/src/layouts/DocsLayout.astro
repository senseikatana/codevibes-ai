---
export interface Props { title: string; active?: string; }
const { title, active = '' } = Astro.props;
const sections = [
  { slug: '', label: 'Resumen' },
  { slug: 'mercado', label: 'Estudio de Mercado' },
  { slug: 'prd', label: 'PRD Mejoras' },
  { slug: 'seo', label: 'Plan SEO' },
  { slug: 'ventas', label: 'Estrategia de Ventas' },
  { slug: 'roadmap', label: 'Roadmap 90 Días' },
  { slug: 'jarvis', label: 'NUM Jarvis (AI)' },
  { slug: 'herramientas', label: 'Herramientas' },
];
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} · NUM Perfume</title>
  <style is:global>
    :root { --bg: #fafaf7; --fg: #1a1a1a; --muted: #6b6b6b; --accent: #8b5cf6; --card: #fff; --border: #e7e5e0; --sidebar-w: 260px; --font: 'Inter', system-ui, sans-serif; }
    * { box-sizing: border-box; margin: 0; }
    html, body { background: var(--bg); color: var(--fg); font-family: var(--font); line-height: 1.65; }
    .layout { display: flex; min-height: 100vh; }
    aside { width: var(--sidebar-w); background: var(--card); border-right: 1px solid var(--border); padding: 2rem 1.25rem; position: sticky; top: 0; height: 100vh; overflow-y: auto; flex-shrink: 0; }
    aside h1 { font-size: 1.1rem; color: var(--accent); margin-bottom: 1.5rem; letter-spacing: -0.02em; }
    aside nav a { display: block; padding: .45rem .75rem; border-radius: 8px; color: var(--muted); text-decoration: none; font-size: .85rem; transition: all .15s; margin-bottom: 2px; }
    aside nav a:hover { background: var(--border); color: var(--fg); }
    aside nav a.active { background: var(--accent); color: white; font-weight: 600; }
    main { flex: 1; max-width: 780px; margin: 0 auto; padding: 2.5rem 2rem; }
    h2 { font-size: 1.5rem; margin: 2.5rem 0 1rem; border-left: 4px solid var(--accent); padding-left: .75rem; }
    h3 { font-size: 1.15rem; margin: 1.5rem 0 .75rem; }
    p { margin-bottom: 1rem; }
    ul, ol { padding-left: 1.5rem; margin-bottom: 1rem; }
    li { margin-bottom: .35rem; }
    code { background: var(--border); padding: .15em .4em; border-radius: 4px; font-size: .9em; }
    pre { background: #1e1e2e; color: #cdd6f4; padding: 1.25rem; border-radius: 10px; overflow-x: auto; margin-bottom: 1.5rem; font-size: .85rem; line-height: 1.6; }
    pre code { background: none; padding: 0; color: inherit; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; }
    th, td { text-align: left; padding: .6rem .8rem; border-bottom: 1px solid var(--border); font-size: .9rem; }
    th { font-weight: 600; background: var(--card); }
    hr { border: 0; border-top: 1px dashed var(--border); margin: 2rem 0; }
    a { color: var(--accent); }
    blockquote { border-left: 4px solid var(--accent); padding: .75rem 1rem; background: var(--card); border-radius: 0 8px 8px 0; margin-bottom: 1rem; }
    @media (max-width: 768px) { aside { display: none; } main { padding: 1.5rem 1rem; } }
  </style>
</head>
<body>
  <div class="layout">
    <aside>
      <h1>NUM Perfume</h1>
      <nav>
        {sections.map(s => (
          <a href={s.slug ? `/${s.slug}/` : '/'} class={active === s.slug ? 'active' : ''}>{s.label}</a>
        ))}
      </nav>
    </aside>
    <main><slot /></main>
  </div>
</body>
</html>
