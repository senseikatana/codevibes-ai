---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout title="Disclosures — KILBURN" description="Every sponsor, affiliate and freebie, listed.">
  <PageHero
    kicker="Legal / Disclosures"
    title="Show me"
    accentWord="the money."
    accent="red"
    lede="2025 sponsors: none active. Buy links may earn a commission. Units: retail or returned."
  />
  <section class="px-6 pb-24">
    <div class="max-w-2xl mx-auto article-body">
      <h3>Sponsors (trailing 12 months)</h3>
      <p>None. Three slots max per year; this space lists them when they exist.</p>
      <h3>Review units</h3>
      <p>Aspect Mini Pro: purchased retail. Framework 16: purchased retail. No kept loaners.</p>
      <h3>Affiliates</h3>
      <p>Picks links may earn a commission at no cost to you. It funds the next retail unit.</p>
    </div>
  </section>
</Layout>
