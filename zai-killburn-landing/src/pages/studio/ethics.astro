---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout
  title="Ethics Policy — KILBURN Studio"
  description="Sponsors, units, corrections. The whole deal, in plain language."
>
  <PageHero
    kicker="Studio / Ethics"
    title="Wrong is fine."
    accentWord="Lying isn't."
    accent="blue"
    lede="Three sponsors max per year. Always disclosed. Never the main video."
  />
  <section class="px-6 pb-24">
    <div class="max-w-2xl mx-auto article-body">
      <h3>Review units</h3>
      <p>
        Everything is bought retail, borrowed from a friend, or returned after testing. No loaners kept, no
        "extended loans".
      </p>
      <h3>Sponsors</h3>
      <p>
        Max three per year, disclosed loudly, never the review itself. If a sponsor touches a category, that
        category goes dark for them that quarter.
      </p>
      <h3>Corrections</h3>
      <p>
        Errors are updated in the video and pinned in the comments + the written companion. The original claim
        stays visible with a strike-through.
      </p>
      <p>
        <a href="/disclosures">Full disclosures →</a>
      </p>
    </div>
  </section>
</Layout>
