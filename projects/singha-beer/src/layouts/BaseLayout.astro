---
export interface Props { title: string; bodyClass?: string; }
const { title, bodyClass = '' } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#051710" />
  <title>{title}</title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link href="https://cdn.jsdelivr.net/fontsource/css/cinzel@latest/latin.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/fontsource/css/archivo@latest/latin.css" rel="stylesheet" />
  <style is:global>
    :root{--green-950:#051710;--green-900:#082418;--green-800:#0d3323;--gold:#d9a83f;--gold-bright:#f2cd6b;--cream:#f4ecd8;--red:#b23a30;--p:0}
    *{margin:0;padding:0;box-sizing:border-box}
    html{scroll-behavior:auto;background:var(--green-950)}
    body{background:var(--green-950);color:var(--cream);font-family:'Archivo',system-ui,sans-serif;overflow-x:hidden;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
    ::selection{background:var(--gold);color:var(--green-950)}
    a:focus-visible,button:focus-visible{outline:1px solid var(--gold);outline-offset:3px}
    .stage{position:fixed;inset:0;z-index:0;overflow:hidden;background:var(--green-950);contain:strict}
    .stage video{width:100%;height:100%;object-fit:cover;transform:translateZ(0);backface-visibility:hidden;pointer-events:none;will-change:transform}
    .stage-fallback{position:absolute;inset:0;opacity:0;transition:opacity 1s;background:radial-gradient(1100px 750px at 72% 18%,rgba(217,168,63,.30),transparent 62%),radial-gradient(900px 700px at 18% 82%,rgba(178,58,48,.22),transparent 60%),radial-gradient(1500px 1100px at 50% 50%,#0d3323,#051710 72%);filter:hue-rotate(calc(var(--p)*28deg)) saturate(calc(1+var(--p)*.35))}
    body.no-video .stage-fallback{opacity:1}body.no-video .stage video{display:none}
    .shade{position:absolute;inset:0;background:rgba(0,0,0,.38)}
    .tint{position:absolute;inset:0;background:linear-gradient(180deg,rgba(5,23,16,.5),rgba(5,23,16,.10) 26%,rgba(5,23,16,.08) 62%,rgba(5,23,16,.62))}
    .vignette{position:absolute;inset:0;background:radial-gradient(125% 92% at 50% 45%,transparent 52%,rgba(0,0,0,.66))}
    .grain{position:absolute;inset:-50%;opacity:.07;mix-blend-mode:overlay;pointer-events:none;transform:translateZ(0);background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/></filter><rect width='160' height='160' filter='url(%23n)' opacity='0.6'/></svg>");animation:grain 7s steps(8) infinite}
    @keyframes grain{0%,100%{transform:translate(0,0)}20%{transform:translate(-3%,2%)}40%{transform:translate(2%,-3%)}60%{transform:translate(-2%,-2%)}80%{transform:translate(3%,3%)}}
    .stage-bubbles{position:absolute;inset:0;z-index:2;opacity:.55}
    .topfade{position:fixed;top:0;left:0;right:0;height:120px;z-index:15;background:linear-gradient(180deg,rgba(0,0,0,.72),transparent);pointer-events:none}
    .progress{position:fixed;top:0;left:0;right:0;height:2px;z-index:30;background:rgba(244,236,216,.08)}
    #progressFill{position:absolute;inset:0;background:linear-gradient(90deg,var(--gold),var(--gold-bright));transform-origin:left;transform:scaleX(0);box-shadow:0 0 12px rgba(217,168,63,.7);will-change:transform;backface-visibility:hidden}
    .topbar{position:fixed;top:0;left:0;right:0;z-index:20;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:1rem;padding:1.05rem clamp(1rem,3vw,2rem);font-size:.7rem;letter-spacing:.28em;text-transform:uppercase}
    .brand{font-family:'Cinzel',serif;color:var(--cream);text-decoration:none;font-weight:700;letter-spacing:.34em;display:flex;align-items:center;gap:.7em;text-shadow:0 1px 10px rgba(0,0,0,.6)}
    .brand i{width:9px;height:9px;background:var(--gold);transform:rotate(45deg);display:inline-block;box-shadow:0 0 14px rgba(217,168,63,.9);transition:transform .5s}
    .brand:hover i{transform:rotate(225deg)}
    .nav{justify-self:center;display:flex;gap:clamp(1rem,2.4vw,2.2rem);align-items:center}
    .nav a{position:relative;color:rgba(244,236,216,.72);text-decoration:none;font-size:.66rem;letter-spacing:.3em;text-transform:uppercase;padding:.4em 0;transition:color .3s;text-shadow:0 1px 10px rgba(0,0,0,.6)}
    .nav a::before{content:"◆";color:var(--gold);font-size:.55em;margin-right:.7em;opacity:0;transition:opacity .3s}
    .nav a:hover{color:var(--cream)}.nav a.act{color:var(--gold)}.nav a.act::before{opacity:1}
    .top-right{justify-self:end;display:flex;gap:1.8em;align-items:center;color:rgba(244,236,216,.78);text-shadow:0 1px 10px rgba(0,0,0,.6)}
    #chapterLabel{color:var(--gold);transition:opacity .28s;max-width:40vw;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .timecode{font-variant-numeric:tabular-nums;letter-spacing:.14em}
    body.is-buffering .timecode::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--gold-bright);margin-right:.7em;vertical-align:1px;animation:pulse 1s ease-in-out infinite}
    @media(max-width:760px){#chapterLabel{display:none}.nav{gap:.95rem}.nav a{font-size:.58rem;letter-spacing:.22em}}
    @media(max-width:640px){.timecode{display:none}.nav{gap:.7rem}.brand{letter-spacing:.22em}}
    .dots{position:fixed;right:clamp(.8rem,2vw,1.6rem);top:50%;transform:translateY(-50%);z-index:20;display:flex;flex-direction:column;gap:15px}
    .dots button{position:relative;width:10px;height:10px;border:1px solid rgba(217,168,63,.6);background:transparent;transform:rotate(45deg);cursor:pointer;transition:background .35s,transform .35s,box-shadow .35s;padding:0}
    .dots button:hover{background:rgba(217,168,63,.45);transform:rotate(45deg) scale(1.3)}
    .dots button.act{background:var(--gold);box-shadow:0 0 14px rgba(217,168,63,.9);transform:rotate(45deg) scale(1.4)}
    .dots button::after{content:attr(data-label);position:absolute;right:26px;top:50%;transform:translateY(-50%) rotate(-45deg);transform-origin:right center;font-family:'Archivo',sans-serif;font-size:.6rem;letter-spacing:.24em;text-transform:uppercase;color:var(--cream);background:rgba(0,0,0,.78);border:1px solid rgba(217,168,63,.35);padding:.5em .9em;white-space:nowrap;opacity:0;transition:opacity .3s;pointer-events:none}
    .dots button:hover::after{opacity:1}
    @media(max-width:860px){.dots{display:none}}
    .hint{position:fixed;left:50%;bottom:1.5rem;transform:translateX(-50%);z-index:20;display:flex;flex-direction:column;align-items:center;gap:.6rem;font-size:.6rem;letter-spacing:.36em;text-transform:uppercase;color:rgba(244,236,216,.9);transition:opacity .5s;white-space:nowrap;text-shadow:0 1px 10px rgba(0,0,0,.7)}
    .hint .mouse{width:1px;height:46px;background:rgba(244,236,216,.22);position:relative;overflow:hidden}
    .hint .mouse::after{content:"";position:absolute;left:0;top:-45%;width:100%;height:45%;background:var(--gold);animation:drip 1.7s ease-in-out infinite}
    @keyframes drip{to{top:115%}}.hint.hide{opacity:0;pointer-events:none}
    .idx{position:fixed;left:clamp(1rem,3vw,2rem);bottom:1.3rem;z-index:20;display:flex;align-items:baseline;gap:.7em;font-family:'Cinzel',serif;letter-spacing:.3em;color:rgba(244,236,216,.8);opacity:0;transition:opacity .5s;text-shadow:0 1px 10px rgba(0,0,0,.7)}
    .idx.show{opacity:1}.idx b{font-size:1.7rem;color:var(--gold);font-weight:700}.idx span{font-size:.62rem;font-family:'Archivo',sans-serif;letter-spacing:.3em}
    @media(max-width:640px){.idx{display:none}}
    body:not([data-route="home"]) .dots,body:not([data-route="home"]) .hint,body:not([data-route="home"]) .idx,body:not([data-route="home"]) .progress,body:not([data-route="home"]) #chapterLabel,body:not([data-route="home"]) .timecode{display:none}
    .page{display:none}.page.active{display:block;animation:pageIn .8s cubic-bezier(.16,1,.3,1) both}
    @keyframes pageIn{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
    #track{position:relative;z-index:2}
    .panel{min-height:100vh;min-height:100svh;display:flex;align-items:center;position:relative;overflow:hidden;padding:14vh clamp(1.2rem,6vw,7rem);contain:layout paint}
    .inner{position:relative;z-index:3;max-width:640px;width:100%}
    .panel.right .inner{margin-left:auto}
    .inner::before{content:"";position:absolute;z-index:-1;pointer-events:none;inset:-3rem -3.5rem;background:radial-gradient(115% 135% at 16% 50%,rgba(0,0,0,.58),rgba(0,0,0,.22) 55%,transparent 80%)}
    .panel.right .inner::before{background:radial-gradient(115% 135% at 84% 50%,rgba(0,0,0,.58),rgba(0,0,0,.22) 55%,transparent 80%)}
    .hero .inner::before{inset:-4rem -2rem;background:radial-gradient(95% 115% at 14% 46%,rgba(0,0,0,.52),rgba(0,0,0,.18) 58%,transparent 82%)}
    .ghost{position:absolute;z-index:1;top:50%;right:-2vw;transform:translateY(-50%);font-family:'Cinzel',serif;font-weight:800;font-size:clamp(9rem,27vw,23rem);line-height:1;color:transparent;-webkit-text-stroke:1px rgba(217,168,63,.22);user-select:none;pointer-events:none;will-change:transform;backface-visibility:hidden}
    .panel.right .ghost{right:auto;left:-2vw}
    .kicker{display:flex;align-items:center;gap:1em;font-size:.66rem;letter-spacing:.42em;text-transform:uppercase;color:var(--gold);margin-bottom:1.5rem;text-shadow:0 1px 14px rgba(0,0,0,.6)}
    .kicker::before{content:"";width:46px;height:1px;background:var(--gold);flex:none}
    h2{font-family:'Cinzel',serif;font-weight:700;font-size:clamp(2.3rem,5.6vw,4.4rem);line-height:1.05;margin-bottom:1.35rem;text-wrap:balance;text-shadow:0 2px 24px rgba(0,0,0,.6)}
    h2 .gold{color:var(--gold)}
    .lead{font-size:clamp(1rem,1.3vw,1.13rem);line-height:1.8;color:rgba(244,236,216,.9);max-width:56ch;text-shadow:0 1px 16px rgba(0,0,0,.55)}
    .note{margin-top:1.7rem;font-size:.72rem;letter-spacing:.2em;color:rgba(217,168,63,.95);text-transform:uppercase;display:flex;gap:.9em;align-items:center;text-shadow:0 1px 12px rgba(0,0,0,.6)}
    .note::before{content:"◆";font-size:.6em;color:var(--red)}.thai{font-size:1.05rem;letter-spacing:.1em;text-transform:none;color:var(--gold-bright)}
    .rv{opacity:0;transform:translateY(46px);transition:opacity .95s cubic-bezier(.16,1,.3,1),transform .95s cubic-bezier(.16,1,.3,1);transition-delay:var(--d,0s)}
    .panel.on .rv{opacity:1;transform:none}.rv.on{opacity:1;transform:none}
    .stats{display:flex;gap:clamp(1.4rem,3vw,3rem);margin-top:2.3rem;flex-wrap:wrap}
    .stats li{list-style:none;border-top:1px solid rgba(217,168,63,.45);padding-top:.95rem;min-width:112px}
    .stats b{display:block;font-family:'Cinzel',serif;font-weight:700;font-size:clamp(1.7rem,2.6vw,2.4rem);color:var(--gold);font-variant-numeric:tabular-nums;text-shadow:0 1px 16px rgba(0,0,0,.55)}
    .stats b em{font-style:normal;font-size:.55em;margin-left:.15em;color:var(--gold-bright)}
    .stats .lbl{display:block;margin-top:.35rem;font-size:.62rem;letter-spacing:.22em;text-transform:uppercase;color:rgba(244,236,216,.66)}
    .chips{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem;margin-top:2.1rem;max-width:460px}
    .chips li{list-style:none;border:1px solid rgba(217,168,63,.35);background:rgba(0,0,0,.42);padding:.95rem 1.1rem;font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;display:flex;gap:.8em;align-items:center;transition:transform .35s,border-color .35s,background .35s}
    .chips li::before{content:"◆";color:var(--gold);font-size:.6em}
    .chips li:hover{transform:translateY(-4px);border-color:var(--gold);background:rgba(217,168,63,.16)}
    @media(max-width:430px){.chips{grid-template-columns:1fr}}
    .tags{display:flex;flex-wrap:wrap;gap:.7rem 1.6rem;margin-top:2.1rem;font-size:.74rem;letter-spacing:.22em;text-transform:uppercase;color:rgba(244,236,216,.9)}
    .tags span{display:flex;align-items:center;gap:.8em;transition:color .3s;text-shadow:0 1px 12px rgba(0,0,0,.6)}
    .tags span::before{content:"◆";color:var(--red);font-size:.6em}.tags span:hover{color:var(--gold-bright)}
    .flavors{margin-top:2.2rem;display:flex;flex-direction:column;gap:1.15rem;max-width:470px}
    .flavor{display:grid;grid-template-columns:118px 1fr 36px;gap:1rem;align-items:center;font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;color:rgba(244,236,216,.85)}
    .flavor .bar{height:6px;background:rgba(244,236,216,.12);position:relative;overflow:hidden}
    .flavor .bar i{position:absolute;inset:0;width:0;background:linear-gradient(90deg,var(--gold),var(--gold-bright));box-shadow:0 0 10px rgba(217,168,63,.5);transition:width 1.3s cubic-bezier(.16,1,.3,1) .3s}
    .panel.on .flavor .bar i{width:var(--w)}.flavor b{font-family:'Cinzel',serif;color:var(--gold);font-size:1rem;text-align:right;font-weight:700}
    @media(max-width:430px){.flavor{grid-template-columns:88px 1fr 32px}}
    .specs{margin-top:2.2rem;max-width:470px}
    .specs div{display:flex;justify-content:space-between;align-items:baseline;gap:1.5rem;border-top:1px solid rgba(217,168,63,.3);padding:1rem 0;transition:padding-left .35s,background .35s}
    .specs div:hover{padding-left:.8rem;background:rgba(217,168,63,.08)}
    .specs dt{font-family:'Cinzel',serif;color:var(--gold);font-size:1rem;font-weight:700;letter-spacing:.04em}
    .specs dd{font-size:.78rem;color:rgba(244,236,216,.78);text-align:right;letter-spacing:.06em}
    .hero{flex-direction:column;justify-content:center;padding-top:18vh}.hero .inner{max-width:none}
    .hero-meta{display:flex;align-items:center;gap:1.1em;font-size:.64rem;letter-spacing:.44em;text-transform:uppercase;color:rgba(244,236,216,.85);margin-bottom:2.4rem;text-shadow:0 1px 12px rgba(0,0,0,.6)}
    .hero-meta i{width:8px;height:8px;background:var(--red);transform:rotate(45deg);flex:none}
    .wordmark{font-family:'Cinzel',serif;font-weight:800;font-size:clamp(4.2rem,16.5vw,14.5rem);line-height:.95;letter-spacing:.02em;display:grid;margin-left:-.03em}
    .wm{grid-area:1/1}.wm.o{color:transparent;-webkit-text-stroke:1.5px rgba(217,168,63,.55);transform:translate(.05em,.055em)}
    .wm.f{color:var(--cream);text-shadow:0 6px 90px rgba(217,168,63,.3),0 2px 30px rgba(0,0,0,.6)}
    .tagline{display:flex;align-items:center;gap:clamp(1rem,2.5vw,1.6rem);margin-top:1.9rem;font-family:'Cinzel',serif;font-weight:700;color:var(--gold);font-size:clamp(.85rem,2vw,1.3rem);letter-spacing:.52em;text-transform:uppercase;white-space:nowrap;text-shadow:0 2px 22px rgba(0,0,0,.65)}
    .tagline::before,.tagline::after{content:"";height:1px;flex:0 0 clamp(2rem,6vw,5rem)}
    .tagline::before{background:linear-gradient(90deg,transparent,rgba(217,168,63,.85))}
    .tagline::after{background:linear-gradient(90deg,rgba(217,168,63,.85),transparent)}
    .hero-sub{margin-top:2rem;max-width:46ch;font-size:clamp(.98rem,1.3vw,1.15rem);line-height:1.85;color:rgba(244,236,216,.9);text-shadow:0 1px 16px rgba(0,0,0,.55)}
    .hero-sub b{color:var(--gold);font-weight:600}
    .badge{position:absolute;right:clamp(1rem,6vw,6rem);bottom:13vh;width:clamp(112px,13vw,172px);z-index:3;filter:drop-shadow(0 2px 14px rgba(0,0,0,.5))}
    .badge .spin{animation:spin 26s linear infinite;transform-origin:100px 100px}
    @keyframes spin{to{transform:rotate(360deg)}}.badge text{fill:var(--gold);font-family:'Archivo',sans-serif}
    .badge .bs{fill:var(--gold);font-family:'Cinzel',serif;font-size:22px;font-weight:700}
    .badge .core{fill:none;stroke:rgba(217,168,63,.65);stroke-width:1}
    @media(max-width:640px){.badge{display:none}}
    .bubbles{position:absolute;inset:0;z-index:1;pointer-events:none;overflow:hidden}
    .bubbles i{position:absolute;bottom:-6%;border-radius:50%;border:1px solid rgba(242,205,107,.45);background:radial-gradient(circle at 32% 30%,rgba(244,236,216,.28),rgba(244,236,216,0) 62%);animation:rise linear infinite;will-change:transform}
    @keyframes rise{0%{transform:translate(0,0)}100%{transform:translate(26px,-108vh);opacity:0}}
    .salud{font-family:'Cinzel',serif;font-weight:800;font-size:clamp(4rem,13vw,11rem);line-height:.95;color:var(--gold);text-shadow:0 0 100px rgba(217,168,63,.4),0 2px 40px rgba(0,0,0,.6)}
    .cta-row{display:flex;gap:1rem;margin-top:2.6rem;flex-wrap:wrap}
    .btn{position:relative;z-index:0;overflow:hidden;font-family:'Archivo',sans-serif;font-size:.7rem;font-weight:600;letter-spacing:.3em;text-transform:uppercase;padding:1.1em 2.3em;border:1px solid var(--gold);color:var(--gold);background:rgba(0,0,0,.35);cursor:pointer;text-decoration:none;display:inline-block;transition:color .4s}
    .btn::before{content:"";position:absolute;inset:0;z-index:-1;background:var(--gold);transform:scaleX(0);transform-origin:left;transition:transform .45s cubic-bezier(.16,1,.3,1)}
    .btn:hover{color:var(--green-950)}.btn:hover::before{transform:scaleX(1)}
    .btn.solid{background:var(--gold);color:var(--green-950)}.btn.solid::before{background:var(--gold-bright)}
    .marquee{position:absolute;left:0;right:0;bottom:56px;z-index:3;border-top:1px solid rgba(217,168,63,.3);border-bottom:1px solid rgba(217,168,63,.3);background:rgba(0,0,0,.5);overflow:hidden;padding:.95rem 0}
    .marquee .lane{display:flex;width:max-content;animation:lane 28s linear infinite;white-space:nowrap;will-change:transform}
    .marquee .grp{font-family:'Cinzel',serif;font-size:.78rem;letter-spacing:.32em;color:rgba(244,236,216,.9);margin-right:3rem}
    .marquee .grp i{font-style:normal;color:var(--gold);margin-left:3rem}
    @keyframes lane{to{transform:translateX(-50%)}}
    .legal{position:absolute;left:0;right:0;bottom:1.2rem;z-index:3;text-align:center;font-size:.56rem;letter-spacing:.32em;text-transform:uppercase;color:rgba(244,236,216,.5);text-shadow:0 1px 8px rgba(0,0,0,.7)}
    .ipage{position:relative;z-index:2;padding:17vh clamp(1.2rem,6vw,7rem) 0;min-height:100vh}
    .ihead{max-width:920px}
    .ititle{font-family:'Cinzel',serif;font-weight:800;font-size:clamp(2.7rem,7vw,5.6rem);line-height:1.03;margin-bottom:1.5rem;text-wrap:balance;text-shadow:0 2px 30px rgba(0,0,0,.65)}
    .ititle .gold{color:var(--gold)}
    .ilead{font-size:clamp(1rem,1.4vw,1.18rem);line-height:1.85;color:rgba(244,236,216,.9);max-width:60ch;text-shadow:0 1px 16px rgba(0,0,0,.6)}
    .isection{margin-top:clamp(4rem,9vw,7rem)}
    .card{position:relative;background:rgba(5,23,16,.8);border:1px solid rgba(217,168,63,.28);padding:clamp(1.6rem,3.6vw,3.2rem)}
    .card::before,.card::after{content:"";position:absolute;width:22px;height:22px;pointer-events:none}
    .card::before{top:-1px;left:-1px;border-top:2px solid var(--gold);border-left:2px solid var(--gold)}
    .card::after{bottom:-1px;right:-1px;border-bottom:2px solid var(--gold);border-right:2px solid var(--gold)}
    .timeline{margin-top:2.6rem;position:relative}
    .timeline::before{content:"";position:absolute;left:5px;top:8px;bottom:8px;width:1px;background:linear-gradient(180deg,var(--gold),rgba(217,168,63,.12))}
    .tl{position:relative;padding:0 0 2.4rem 2.6rem;transition:transform .4s}
    .tl:last-child{padding-bottom:.4rem}
    .tl::before{content:"";position:absolute;left:0;top:.55em;width:9px;height:9px;background:var(--green-950);border:1px solid var(--gold);transform:rotate(45deg);transition:.35s}
    .tl:hover{transform:translateX(7px)}.tl:hover::before{background:var(--gold);box-shadow:0 0 14px rgba(217,168,63,.8)}
    .tl b{display:block;font-family:'Cinzel',serif;color:var(--gold);font-size:1.5rem;font-weight:700;margin-bottom:.3rem}
    .tl h4{font-size:.78rem;letter-spacing:.24em;text-transform:uppercase;color:var(--cream);margin-bottom:.55rem}
    .tl p{color:rgba(244,236,216,.74);line-height:1.75;font-size:.94rem;max-width:60ch}
    .duo{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(2rem,4.5vw,4.5rem);align-items:center;margin-top:3rem}
    .duo.rev{grid-template-columns:.95fr 1.05fr}.duo.rev .ph{order:2}
    .duo .dtext h2{font-size:clamp(1.9rem,3.6vw,3rem)}.duo .dtext p{color:rgba(244,236,216,.82);line-height:1.8;margin-bottom:1.1rem;max-width:52ch}
    @media(max-width:920px){.duo,.duo.rev{grid-template-columns:1fr}.duo.rev .ph{order:0}}
    .ph{position:relative;overflow:hidden;border:1px solid rgba(217,168,63,.3);background:var(--green-900)}
    .ph img{display:block;width:100%;height:auto;transform:scale(1.05);transition:transform 1.3s cubic-bezier(.16,1,.3,1);filter:saturate(.94) contrast(1.03)}
    .ph:hover img{transform:scale(1)}
    .ph figcaption{position:absolute;left:0;bottom:0;background:rgba(0,0,0,.7);border-top:1px solid rgba(217,168,63,.45);border-right:1px solid rgba(217,168,63,.45);padding:.7em 1.2em;font-size:.6rem;letter-spacing:.26em;text-transform:uppercase;color:var(--gold)}
    .mrow{display:grid;grid-template-columns:clamp(70px,10vw,130px) 1fr;gap:1.5rem;border-top:1px solid rgba(217,168,63,.3);padding:2rem 0;transition:padding-left .4s,background .4s}
    .mrow:last-child{border-bottom:1px solid rgba(217,168,63,.3)}.mrow:hover{padding-left:1.2rem;background:rgba(217,168,63,.05)}
    .mrow .num{font-family:'Cinzel',serif;font-size:clamp(2rem,4vw,3.2rem);color:transparent;-webkit-text-stroke:1px rgba(217,168,63,.7);transition:.4s;line-height:1}
    .mrow:hover .num{color:var(--gold);-webkit-text-stroke:1px var(--gold)}
    .mrow h3{font-family:'Cinzel',serif;font-size:1.35rem;color:var(--cream);margin-bottom:.5rem;letter-spacing:.04em}
    .mrow p{color:rgba(244,236,216,.76);line-height:1.75;max-width:62ch;font-size:.96rem}
    .nstrip{display:flex;flex-wrap:wrap;margin-top:3.5rem;border-top:1px solid rgba(217,168,63,.35);border-bottom:1px solid rgba(217,168,63,.35)}
    .nstrip div{flex:1 1 150px;padding:1.8rem 1.4rem;border-left:1px solid rgba(217,168,63,.2)}.nstrip div:first-child{border-left:none}
    .nstrip b{font-family:'Cinzel',serif;font-size:clamp(2rem,3.4vw,2.8rem);color:var(--gold);display:block;font-variant-numeric:tabular-nums}
    .nstrip b em{font-style:normal;font-size:.5em;color:var(--gold-bright)}
    .nstrip span{display:block;margin-top:.4rem;font-size:.6rem;letter-spacing:.24em;text-transform:uppercase;color:rgba(244,236,216,.6)}
    .iquote{margin:clamp(4rem,8vw,6rem) auto 0;max-width:880px;text-align:center;padding:0 1rem}
    .iquote::before{content:"\u201C";display:block;font-family:'Cinzel',serif;font-size:4rem;color:var(--gold);line-height:.6;margin-bottom:1.2rem;text-shadow:0 0 30px rgba(217,168,63,.5)}
    .iquote p{font-family:'Cinzel',serif;font-size:clamp(1.5rem,3.4vw,2.5rem);line-height:1.35;color:var(--cream);text-shadow:0 2px 26px rgba(0,0,0,.6)}
    .iquote p b{color:var(--gold);font-weight:700}
    .iquote span{display:block;margin-top:1.4rem;font-size:.62rem;letter-spacing:.34em;text-transform:uppercase;color:rgba(217,168,63,.85)}
    .ctaband{margin-top:clamp(4rem,8vw,6rem)}
    .ctaband .card{display:flex;flex-wrap:wrap;gap:2rem;align-items:center;justify-content:space-between}
    .ctaband h2{margin-bottom:.6rem;font-size:clamp(1.8rem,3.4vw,2.8rem)}.ctaband p{color:rgba(244,236,216,.78);max-width:46ch}
    .cgrid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2rem,4vw,3.5rem);margin-top:3.5rem;align-items:start}
    @media(max-width:920px){.cgrid{grid-template-columns:1fr}}
    .formtitle{font-family:'Cinzel',serif;font-size:1.2rem;letter-spacing:.06em;color:var(--cream);margin-bottom:1.6rem;display:flex;align-items:center;gap:.8em}
    .formtitle::before{content:"";width:8px;height:8px;background:var(--gold);transform:rotate(45deg)}
    .field{margin-bottom:1.4rem}
    .field label{display:block;font-size:.6rem;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);margin-bottom:.6rem}
    .field input,.field select,.field textarea{width:100%;background:rgba(0,0,0,.35);border:1px solid rgba(217,168,63,.3);color:var(--cream);font-family:'Archivo',sans-serif;font-size:.95rem;padding:.95em 1.1em;transition:border-color .3s,background .3s,box-shadow .3s;border-radius:0;-webkit-appearance:none;appearance:none}
    .field input::placeholder,.field textarea::placeholder{color:rgba(244,236,216,.4)}
    .field input:focus,.field select:focus,.field textarea:focus{border-color:var(--gold);background:rgba(0,0,0,.5);outline:none;box-shadow:0 0 0 1px rgba(217,168,63,.3)}
    .field select{cursor:pointer;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8'><path d='M1 1l5 5 5-5' fill='none' stroke='%23d9a83f' stroke-width='1.5'/></svg>");background-repeat:no-repeat;background-position:right 1.1em center;padding-right:2.6em}
    .field select option{background:var(--green-900);color:var(--cream)}
    .field textarea{min-height:140px;resize:vertical;line-height:1.6}
    .field.err input,.field.err select,.field.err textarea{border-color:var(--red)}
    .field .msg{display:none;color:#e08a80;font-size:.66rem;margin-top:.45rem;letter-spacing:.08em}
    .field.err .msg{display:block}
    .age{display:flex;gap:.9em;align-items:flex-start;cursor:pointer;font-size:.78rem;color:rgba(244,236,216,.82);line-height:1.5;margin:1.6rem 0}
    .age input{position:absolute;opacity:0;width:0;height:0}
    .age i{flex:none;width:15px;height:15px;border:1px solid var(--gold);transform:rotate(45deg);margin-top:.15em;transition:.3s}
    .age input:checked+i{background:var(--gold);box-shadow:0 0 12px rgba(217,168,63,.6)}
    .age.err i{border-color:var(--red)}
    .sent{display:none;padding:1rem 0}.form-wrap.done form{display:none}
    .form-wrap.done .sent{display:block;animation:pageIn .6s both}
    .sent-mark{width:46px;height:46px;border:1px solid var(--gold);transform:rotate(45deg);display:grid;place-items:center;margin-bottom:1.6rem;animation:pulse 2.4s ease-in-out infinite}
    @keyframes pulse{50%{box-shadow:0 0 34px rgba(217,168,63,.55)}}
    .sent-mark::after{content:"◆";transform:rotate(-45deg);color:var(--gold);font-size:1rem}
    .sent .big{font-family:'Cinzel',serif;color:var(--gold);font-size:1.9rem;margin-bottom:.6rem}
    .info .blk{border-top:1px solid rgba(217,168,63,.3);padding:1.4rem 0}.info .blk:first-child{border-top:none;padding-top:0}
    .blk h4{font-size:.6rem;letter-spacing:.3em;text-transform:uppercase;color:var(--gold);margin-bottom:.8rem}
    .blk p{color:rgba(244,236,216,.85);line-height:1.7;font-size:.92rem;margin-bottom:.3rem}
    .blk a{color:var(--cream);text-decoration:none;border-bottom:1px solid rgba(217,168,63,.4);transition:.3s}
    .blk a:hover{color:var(--gold);border-color:var(--gold)}
    .socials{display:flex;flex-wrap:wrap;gap:1.3rem;margin-top:.3rem}
    .socials a{display:inline-flex;align-items:center;gap:.5em;border:none;color:rgba(244,236,216,.85);font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;transition:color .3s,gap .3s}
    .socials a::after{content:"\u2197";color:var(--gold);transition:transform .3s}.socials a:hover{color:var(--gold)}.socials a:hover::after{transform:translate(3px,-3px)}
    .ph.compact{margin-top:1.6rem}
    .faq{max-width:820px;margin-top:2.6rem}
    .q{border-top:1px solid rgba(217,168,63,.3)}.q:last-child{border-bottom:1px solid rgba(217,168,63,.3)}
    .q button{width:100%;background:none;border:none;color:var(--cream);display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1.3rem .2rem;cursor:pointer;font-family:'Cinzel',serif;font-size:1.05rem;letter-spacing:.03em;text-align:left;transition:color .3s}
    .q button:hover{color:var(--gold)}
    .q button i{flex:none;width:10px;height:10px;border-right:1px solid var(--gold);border-bottom:1px solid var(--gold);transform:rotate(45deg);transition:transform .4s}
    .q.open button i{transform:rotate(-135deg)}
    .q .a{max-height:0;overflow:hidden;transition:max-height .5s cubic-bezier(.16,1,.3,1)}
    .q .a p{padding:0 .2rem 1.4rem;color:rgba(244,236,216,.76);line-height:1.75;font-size:.94rem;max-width:65ch}
    .ifoot{position:relative;z-index:2;margin-top:6rem;border-top:1px solid rgba(217,168,63,.3);background:rgba(0,0,0,.5);padding:2.6rem clamp(1.2rem,6vw,7rem);display:flex;flex-wrap:wrap;gap:1.6rem;justify-content:space-between;align-items:center}
    .ifoot .fb{font-family:'Cinzel',serif;letter-spacing:.34em;color:var(--cream);font-weight:700;display:flex;align-items:center;gap:.7em}
    .ifoot .fb i{width:9px;height:9px;background:var(--gold);transform:rotate(45deg);display:inline-block}
    .ifoot .ft2{font-family:'Cinzel',serif;font-size:.62rem;letter-spacing:.4em;text-transform:uppercase;color:var(--gold);margin-top:.5rem}
    .ifoot .fnav{display:flex;gap:1.6rem;flex-wrap:wrap}
    .ifoot .fnav a{color:rgba(244,236,216,.75);text-decoration:none;font-size:.64rem;letter-spacing:.26em;text-transform:uppercase;transition:color .3s}
    .ifoot .fnav a:hover{color:var(--gold)}
    .ifoot .ft{font-size:.56rem;letter-spacing:.28em;text-transform:uppercase;color:rgba(244,236,216,.5);max-width:240px;text-align:right}
    @media(max-width:640px){.ifoot .ft{text-align:left;max-width:none}}
    body[data-route="home"] .ifoot{display:none}
    #loader{position:fixed;inset:0;z-index:100;background:radial-gradient(900px 620px at 50% 42%,#0d3323,#051710 76%);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1.7rem;transition:opacity .8s,visibility .8s}
    #loader.done{opacity:0;visibility:hidden}
    #loader .mark{width:54px;height:54px;border:1px solid var(--gold);transform:rotate(45deg);display:grid;place-items:center;animation:pulse 2s ease-in-out infinite}
    #loader .mark b{transform:rotate(-45deg);font-family:'Cinzel',serif;color:var(--gold);font-size:1.5rem;font-weight:700}
    #loader .lword{font-family:'Cinzel',serif;letter-spacing:.55em;color:var(--cream);font-size:.95rem;padding-left:.55em}
    #loader .ltag{font-family:'Cinzel',serif;font-size:.58rem;letter-spacing:.62em;color:var(--gold);padding-left:.62em;margin-top:-.7rem}
    .lbar{width:230px;height:1px;background:rgba(244,236,216,.15)}
    .lbar i{display:block;height:100%;width:0;background:var(--gold);transition:width .3s}
    #loader small{font-size:.6rem;letter-spacing:.32em;text-transform:uppercase;color:rgba(244,236,216,.55)}
    @media(prefers-reduced-motion:reduce){.badge .spin,.marquee .lane,.hint .mouse::after,.grain,.bubbles i,#loader .mark,.sent-mark{animation:none}.rv,.flavor .bar i{transition:none}}
  </style>
</head>
<body data-route={bodyClass}>
  <slot />
</body>
</html>
