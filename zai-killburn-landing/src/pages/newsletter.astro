---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---

<Layout
  title="Newsletter — KILBURN"
  description="One email every Sunday. Three products, two opinions, zero filler."
>
  <PageHero
    kicker="/ 04 — Direct Line"
    title="Get the takes"
    accentWord="before they're public."
    accent="red"
    lede="47,831 readers. One email every Sunday. No spam, one-click unsubscribe."
  />
  <section class="px-6 pb-24">
    <form
      class="text-left max-w-2xl mx-auto"
      id="newsletterForm"
      hx-post="/api/subscribe"
      hx-target="#subscribeStatus"
      hx-swap="innerHTML"
    >
      <div class="flex items-end gap-4 mb-4">
        <div class="flex-1">
          <label
            class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)] mb-2 block"
            for="emailInput"
          >
            Your Email Address
          </label>
          <input
            type="email"
            id="emailInput"
            name="email"
            class="newsletter-input"
            placeholder=""
            autocomplete="email"
          />
        </div>
        <button type="submit" class="btn-primary mb-3 whitespace-nowrap">
          Subscribe <i class="fas fa-arrow-right text-[10px]"></i>
        </button>
      </div>
      <div class="text-xs text-[var(--fg-dim)] flex items-center gap-3 mb-2">
        <i class="fas fa-shield-halved"></i>
        <span>No spam. I personally read every reply — even the angry ones.</span>
      </div>
      <div
        id="subscribeStatus"
        class="text-xs font-mono mt-3"
        style="color: var(--section-accent); min-height: 1em;"
      ></div>
    </form>
    <div class="mt-16 grid grid-cols-3 gap-6 max-w-2xl mx-auto">
      <div>
        <div class="font-display text-4xl md:text-5xl" style="color: var(--section-accent)">
          47K
        </div>
        <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)] mt-2">
          Subscribers
        </div>
      </div>
      <div>
        <div class="font-display text-4xl md:text-5xl">52</div>
        <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)] mt-2">
          Issues Sent
        </div>
      </div>
      <div>
        <div class="font-display text-4xl md:text-5xl">4.3</div>
        <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)] mt-2">
          Min Avg Read
        </div>
      </div>
    </div>
  </section>
</Layout>
