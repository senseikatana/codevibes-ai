---
import Layout from '../../layouts/Layout.astro';
import { videos } from '../../data/library';

export function getStaticPaths() {
  return videos.map((v) => ({ params: { id: String(v.id) } }));
}

const { id } = Astro.params;
const video = videos.find((v) => String(v.id) === id);
if (!video) return Astro.redirect('/videos');
const related = videos.filter((v) => v.id !== video.id).slice(0, 3);
---

<Layout title={`${video.title} — KILBURN`} description={video.title}>
  <section class="pt-32 pb-12 px-6" data-accent="red">
    <div class="max-w-[1600px] mx-auto">
      <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--accent)] mb-2">
        Ep. {video.id} · {video.cat} · {video.date}
      </div>
      <h1 class="font-display text-4xl md:text-6xl mb-5 max-w-4xl" style="text-wrap: balance">
        {video.title}
      </h1>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-[var(--fg-dim)] font-mono mb-8">
        <span>{video.runtime}</span>
        <span>·</span>
        <span>{video.views} views</span>
        <span>·</span>
        <span class="text-[var(--accent)]">No sponsor</span>
      </div>
      <div class="video-player-shell">
        <div class="video-player-screen">
          <img src={`https://picsum.photos/seed/${video.img}/1280/720`} alt={video.title} />
          <div class="absolute inset-0 flex items-center justify-center bg-black/30">
            <span class="w-16 h-16 bg-white/95 text-black flex items-center justify-center">
              <i class="fas fa-play text-xl"></i>
            </span>
          </div>
        </div>
        <div class="video-controls">
          <div class="video-progress">
            <div class="video-progress-fill"></div>
          </div>
          <div class="flex items-center justify-between text-white text-xs font-mono">
            <span>00:00 / {video.runtime}</span>
            <span>4K · HDR</span>
          </div>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/reviews/ep-247" class="btn-primary">
          Read the deep-dive <i class="fas fa-arrow-right text-[10px]"></i>
        </a>
        <a href="/videos" class="btn-outline">
          All videos
        </a>
      </div>
    </div>
  </section>
  <section class="px-6 pb-24">
    <div class="max-w-[1600px] mx-auto">
      <div class="text-[10px] font-mono uppercase tracking-widest text-[var(--fg-dim)] mb-4">Up next</div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {related.map((r) => (
          <a href={`/videos/ep-${r.id}`} class="rec-card p-5 block hover:border-[var(--yellow)]">
            <div class="text-[10px] font-mono text-[var(--fg-dim)] mb-2">
              EP {r.id} · {r.runtime}
            </div>
            <div class="font-display text-xl leading-tight">{r.title}</div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
